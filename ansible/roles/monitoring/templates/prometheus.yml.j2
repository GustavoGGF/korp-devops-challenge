# ==============================================================================
# Prometheus Configuration — Korp DevOps Platform
# Gerenciado via Ansible — Alterações manuais serão sobrescritas
# ==============================================================================
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_evaluation_interval }}

rule_files:
  - "/etc/prometheus/rules/*.yml"

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]
        labels:
          environment: "production"

  - job_name: "{{ app_service_name }}"
    metrics_path: "/metrics"
    static_configs:
      - targets: ["{{ app_service_name }}:{{ app_internal_port }}"]
        labels:
          environment: "production"
          service: "{{ app_service_name }}"

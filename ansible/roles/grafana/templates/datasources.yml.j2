# ==============================================================================
# Grafana Datasources Provisioning — Korp DevOps Platform
# Gerenciado via Ansible — Alterações manuais serão sobrescritas
# ==============================================================================
apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    uid: {{ grafana_datasource_uid }}
    editable: false
    jsonData:
      timeInterval: 15s
      httpMethod: POST

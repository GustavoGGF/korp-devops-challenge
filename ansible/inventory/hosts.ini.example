# Exemplo de inventário de hosts para automação Ansible
#
# Para executar contra um servidor remoto (Ubuntu/Debian com SSH e sudo):
# [korp_servers]
# 192.168.1.50 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa ansible_python_interpreter=/usr/bin/python3
#
# Para executar contra localhost em ambiente local/laboratório:
[korp_servers]
localhost ansible_connection=local ansible_python_interpreter=/usr/bin/python3

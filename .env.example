# ==============================================================================
# Ambiente Local de Desenvolvimento / Laboratório — Korp DevOps Platform
# ==============================================================================
# ATENÇÃO: Este fluxo de laboratório NÃO deve ser utilizado em produção.
# Em produção, utilize a automação com Ansible Vault (ansible/site.yml).
#
# Para executar localmente via Docker Compose:
#   1. Copie este arquivo para .env:
#        cp .env.example .env
#   2. Defina uma senha forte em GRAFANA_ADMIN_PASSWORD.
#   3. Execute o Compose:
#        docker compose up -d --build
# ==============================================================================

# Usuário administrativo do Grafana
GRAFANA_ADMIN_USER=admin

# Senha administrativa do Grafana (OBRIGATÓRIO - defina uma senha forte)
# Exemplo: GRAFANA_ADMIN_PASSWORD=SuaSenhaForte123!
GRAFANA_ADMIN_PASSWORD=
